NODE_ENV=development
PORT=3000

# App connects through PgBouncer
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=grocery_db
DB_USER=grocery_user
DB_PASSWORD=grocery_pass

# Direct connection for migrations (bypasses PgBouncer)
DB_MIGRATE_HOST=postgres
DB_MIGRATE_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

LOG_LEVEL=info
TRANSACTION_MAX_RETRIES=3
TRANSACTION_RETRY_DELAY_MS=50
DB_STATEMENT_TIMEOUT_MS=5000
